# Copy to .env and fill in real values:  Copy-Item .env.example .env
# Never commit .env.

# --- LLM (Google Gemini API, FREE TIER ONLY) ---
# Create a key in Google AI Studio (https://aistudio.google.com/apikey) in a project with NO billing linked.
GEMINI_API_KEY=your-gemini-api-key-here
# Must be on the verified free-tier allowlist in app/llm/gemini_client.py (FREE_TIER_MODELS);
# any other model is refused before a request is sent.
LLM_MODEL=gemini-3.8-flash
# Output-token ceiling per answer (includes thinking tokens).
LLM_MAX_TOKENS=8192
# low | medium | high  (lower uses fewer free-tier tokens)
LLM_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=120
# Bounded retries for per-minute 429 only. Daily-quota exhaustion is never retried.
LLM_MAX_RETRIES=2
LLM_RETRY_MAX_WAIT_SECONDS=60
# HTTP 503 UNAVAILABLE (model overloaded): up to 3 retries after ~3, 8, 15 s (or Google's retryDelay),
# within this total wait budget. Other 5xx errors are not retried automatically (use Retry in the chat).
LLM_OVERLOAD_MAX_RETRIES=3
LLM_OVERLOAD_MAX_TOTAL_WAIT_SECONDS=30

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=30
RRF_K=60
# Reranker: none | cross-encoder
RERANKER=none
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Minimum cosine similarity for a vector hit to count as evidence (0 disables).
# Uncalibrated by default — tune with the evaluation runner before relying on it.
MIN_VECTOR_SIMILARITY=0
# Article-aware retrieval ("What is Article 14?"): the article's own text first, then up to N continuation
# chunks and up to N provisions that substantively qualify it (exceptions, "notwithstanding ..."). Passages
# that merely mention the article and table-of-contents pages are excluded.
ARTICLE_MAX_CONTINUATION=3
ARTICLE_MAX_RELATED=2

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=200

# --- Ingestion ---
OCR_ENABLED=false
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
PDF_EXTRACT_TABLES=true
MAX_UPLOAD_MB=25

# --- Current-affairs freshness policy ---
FRESHNESS_MAX_AGE_DAYS=365

# --- UI ---
API_BASE_URL=http://127.0.0.1:8000

# --- Logging ---
# Rotating backend log (5 MB x 5 files), relative to the project root. Empty = console only.
# Secrets are redacted; prompts and retrieved passages are never logged.
LOG_FILE=logs/backend.log
